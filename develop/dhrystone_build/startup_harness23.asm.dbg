0000 48 .org  $0000
0000 49 .word _startup          ; reset
0002 51 .org  $0002
0002 52 .word _timer_handler    ; IRQ0: YSD8002タイマー
0004 54 .org  $0004
0004 55 .word _irq1_handler     ; IRQ1: YSD8004経由デバイス
0006 57 .org  $0006
0006 58 .word _align_handler    ; IRQ3: アラインメント例外（NMI扱い）
0008 60 .org  $0008
0008 61 .word _syscall_handler  ; IRQ4: SYSCALL
000a 66 .org  $000A
000a 68 .word _harness_dispatch
000c 74 .org  $000C
000c 76 .word $0000
000e 77 .org  $000E
000e 79 .word $0000
0010 80 .org  $0010
0010 82 .word $0000
0012 85 .org  $0018
0018 87 LDW  SP, #$F7FE         ; Cスタック初期値
001c 88 LDW  X,  #$0000         ; フレームポインタ初期化
0020 89 EI                      ; 割り込み許可
0021 90 JSR  $04cc              ; v1.5: シンボル参照（lnk23がR_ABS16で解決）
0024 92 HALT
0025 106 STW  A, [_isr_wk_a]     ; A/B/X を退避（中断されたコードを保護）
0029 107 STW  B, [_isr_wk_b]
002d 108 STW  X, [_isr_wk_x]
0031 110 LDW  A, #$FC90          ; TCR アドレス
0035 111 LDW  B, #$0023          ; TIMER_EN|IRQ_EN|IRQ_ACK ＝ ACK＋再武装
0039 112 STW  B, [A]             ; TCR ← 状態ビット込みの完全値
003b 115 LDW  A, [_isr_wk_a]     ; A/B/X を復元
003f 116 LDW  B, [_isr_wk_b]
0043 117 LDW  X, [_isr_wk_x]
0047 118 IRET
0048 133 STW  A, [_isr_wk_a]
004c 134 STW  B, [_isr_wk_b]
0050 135 STW  X, [_isr_wk_x]
0054 138 LDW  A, #$FCB2      ; IRQ_STAT アドレス
0058 139 LDW  B, [A]         ; IRQ_STATを読み出し
005a 140 STW  B, [A]         ; Write-to-Clear（読み出し値を書き戻す）
005c 142 LDW  A, [_isr_wk_a] ; A/B/X を復元
0060 143 LDW  B, [_isr_wk_b]
0064 144 LDW  X, [_isr_wk_x]
0068 145 IRET
0069 151 HALT                ; アラインメント例外は致命的エラー → HALT
006a 175 JMP  _harness_dispatch      ; 直接ジャンプ（暫定）
006d 181 IRET
