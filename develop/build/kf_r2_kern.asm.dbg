137b 1855 LDW  A, #$FFFE              ; ERR_IPC_NOSLOT
137f 1856 RET
1380 1859 STW  A, [IPC4_WK_IDX]      ; idx 退避
1384 1862 LDW  B, #4
1388 1863 SHL  A, B                   ; A = idx × 16
138a 1864 LDW  B, #$4500              ; MSG_POOL_BASE
138e 1865 ADD  A, B                   ; A = &MsgPool[idx]
1390 1866 STW  A, [L1_WK_A]          ; entry_addr 退避
1394 1867 MOV  X, A
1396 1870 LDW  A, [X + #10]           ; A = entry.next
139a 1871 STW  A, [MSG_POOL_FREE]
139e 1874 LDW  A, [CUR_TASK]
13a2 1875 STW  A, [X + #0]            ; sender = CUR_TASK
13a6 1881 LDW  X, [IPC4_WK_X]        ; X = DSP（msg0 先頭）
13aa 1882 LDW  A, [X]                 ; msg0
13ac 1883 LDW  X, [L1_WK_A]
13b0 1884 STW  A, [X + #2]            ; entry.msg[0] = msg0
13b4 1886 LDW  X, [IPC4_WK_X]
13b8 1887 LDW  A, [X + #2]            ; msg1
13bc 1888 LDW  X, [L1_WK_A]
13c0 1889 STW  A, [X + #4]            ; entry.msg[1] = msg1
13c4 1891 LDW  X, [IPC4_WK_X]
13c8 1892 LDW  A, [X + #4]            ; msg2
13cc 1893 LDW  X, [L1_WK_A]
13d0 1894 STW  A, [X + #6]            ; entry.msg[2] = msg2
13d4 1896 LDW  X, [IPC4_WK_X]
13d8 1897 LDW  A, [X + #6]            ; msg3
13dc 1898 LDW  X, [L1_WK_A]
13e0 1899 STW  A, [X + #8]            ; entry.msg[3] = msg3
13e4 1901 LDW  A, #$FFFF              ; IDX_NIL
13e8 1902 STW  A, [X + #10]           ; entry.next = IDX_NIL（末尾になる）
13ec 1906 LDW  A, [IPC4_WK_DST]      ; A = dst_tid
13f0 1907 STW  A, [L1_WK_TMP]
13f4 1908 LDW  B, #6
13f8 1909 SHL  A, B                   ; A = tid*64
13fa 1910 STW  A, [L1_WK_C]
13fe 1911 LDW  A, [L1_WK_TMP]
1402 1912 LDW  B, #4
1406 1913 SHL  A, B                   ; A = tid*16
1408 1914 LDW  B, [L1_WK_C]
140c 1915 ADD  A, B                   ; A = tid*80
140e 1916 LDW  B, #$4000
1412 1917 ADD  A, B                   ; A = &TCB[dst_tid]
1414 1918 STW  A, [IPC4_WK_SRCTCB]  ; ここではdst_tcbを保管（変数名は使い回し）
1418 1919 MOV  X, A                   ; X = dst_tcb
141a 1921 LDW  A, [X + #30]           ; A = dst_tcb.ipc_queue_head
141e 1922 CMPI A, #$FFFF              ; head == IDX_NIL（キュー空）?
1422 1923 BNE  _enq_notempty
1425 1926 LDW  A, [IPC4_WK_IDX]
1429 1927 STW  A, [X + #30]           ; ipc_queue_head = idx
142d 1928 STW  A, [X + #14]           ; ipc_queue_tail = idx
1431 1929 JMP  _enq_queued
1434 1933 LDW  A, [X + #14]           ; A = old_tail_idx
1438 1934 STW  A, [L1_WK_TMP]        ; old_tail_idx 退避
143c 1937 LDW  B, #4
1440 1938 SHL  A, B                   ; A = old_tail_idx × 16
1442 1939 LDW  B, #$4500
1446 1940 ADD  A, B                   ; A = &MsgPool[old_tail]
1448 1941 MOV  X, A
144a 1942 LDW  A, [IPC4_WK_IDX]
144e 1943 STW  A, [X + #10]           ; MsgPool[old_tail].next = idx
1452 1946 LDW  X, [IPC4_WK_SRCTCB]
1456 1947 LDW  A, [IPC4_WK_IDX]
145a 1948 STW  A, [X + #14]           ; ipc_queue_tail = idx
145e 1952 LDW  X, [IPC4_WK_SRCTCB]
1462 1953 LDW  A, [X]                 ; dst_tcb.state
1464 1954 CMPI A, #5                  ; TASK_WAIT_IPC?
1468 1955 BNE  _enq_done
146b 1956 LDW  A, #1
146f 1957 STW  A, [X]                 ; dst_tcb.state = READY
1471 1960 LDW  A, #0                  ; OK
1475 1961 RET
