0000 5 <reset>
0100 8 LDW SP, #0x7ff0
0104 11 LDW A, #1
0108 12 LDW B, #0xffff
010c 13 ADD A, B         ; 1 + (-1) = 0
010e 14 BEQ z_ok
0111 15 LDW A,#0xdead
0115 16 STW A,[0x2100]
0119 17 HALT
011a 19 LDW A,#1
011e 20 STW A,[0x2100]
0122 23 LDW A,#1
0126 24 LDW B,#2
012a 25 SUB A,B          ; -1 вк 0xffff
012c 26 BLT n_ok         ; N=1
012f 27 LDW A,#0xdead
0133 28 STW A,[0x2102]
0137 29 HALT
0138 31 LDW A,#1
013c 32 STW A,[0x2102]
0140 35 LDW A,#0x7fff
0144 36 ADDI A,#1        ; 0x8000
0148 37 BLT neg_ok
014b 38 LDW A,#0xdead
014f 39 STW A,[0x2104]
0153 40 HALT
0154 42 LDW A,#1
0158 43 STW A,[0x2104]
015c 45 HALT
